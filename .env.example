# Google Cloud Project & Region Configuration
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="us-central1"

# BigQuery Dataset Prefix
# Creates: <prefix>_raw, <prefix>_staging, <prefix>_marts
DBT_DATASET_PREFIX="ecommerce"

# Dataplex Knowledge Catalog Entry Group for dbt Metadata Ingestion
DATAPLEX_ENTRY_GROUP="dbt-metadata-ingestion"
